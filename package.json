{
  "name": "swarm-surge",
  "version": "1.0.0",
  "private": true,
  "description": "SWARM SURGE - an original one-finger swarm arcade game for iOS and Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vitest run tests/balance.sim.test.ts",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "e2e": "node scripts/e2e.mjs",
    "assets": "node scripts/gen-assets.mjs",
    "build:single": "node scripts/build-artifact.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1"
  }
}
